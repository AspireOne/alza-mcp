{
  "name": "alza-mcp",
  "mcpName": "io.github.lukabudik/alza-mcp",
  "version": "0.2.0",
  "description": "Unofficial read-only Alza.cz product research MCP server with persistent browser sessions and bounded challenge recovery.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "alza-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:api": "tsx scripts/validate-api.ts",
    "prepublishOnly": "npm run build",
    "validate:soak": "tsx scripts/validate-api.ts --soak"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alza",
    "alza.cz",
    "ecommerce",
    "shopping",
    "claude",
    "anthropic",
    "ai",
    "agent"
  ],
  "author": "alza-mcp contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukabudik/alza-mcp.git"
  },
  "homepage": "https://github.com/lukabudik/alza-mcp#readme",
  "bugs": {
    "url": "https://github.com/lukabudik/alza-mcp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cheerio": "^1.0.0",
    "json5": "2.2.3",
    "patchright": "1.63.0",
    "proper-lockfile": "4.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
