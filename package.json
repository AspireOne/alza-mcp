{
  "name": "alza-mcp",
  "private": true,
  "version": "0.2.0",
  "description": "Unofficial read-only Alza.cz product research MCP server with persistent browser sessions and bounded challenge recovery.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "alza-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.check.json",
    "validate:api": "tsx scripts/validate-api.ts",
    "validate:soak": "tsx scripts/validate-api.ts --soak",
    "stack:local": "node scripts/local-stack.mjs",
    "validate:smoke": "tsx scripts/validate-api.ts --smoke"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alza",
    "alza.cz",
    "ecommerce",
    "shopping",
    "claude",
    "anthropic",
    "ai",
    "agent"
  ],
  "author": "Matěj Pešl (AspireOne)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AspireOne/alza-mcp.git"
  },
  "homepage": "https://github.com/AspireOne/alza-mcp#readme",
  "bugs": {
    "url": "https://github.com/AspireOne/alza-mcp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "cheerio": "^1.2.0",
    "jose": "^6.2.13",
    "json5": "2.2.3",
    "patchright": "1.64.1",
    "proper-lockfile": "4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
