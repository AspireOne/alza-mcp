# Generate with: openssl rand -hex 32
ALZA_HTTP_AUTH=token
ALZA_MCP_TOKEN=
ALZA_ACCESS_TEAM_DOMAIN=
ALZA_ACCESS_AUDIENCE=
ALZA_ACCESS_EMAIL=
# HTTPS origin used by Cloudflare Tunnel, without a path.
ALZA_PUBLIC_URL=https://alza.example.com
# browser (default) or api; see README "Choose a backend".
ALZA_BACKEND=browser
ALZA_AUTH_MODE=preferred
ALZA_BROWSER_CONCURRENCY=2
ALZA_BROWSER_IDLE_TIMEOUT_MS=3600000
